# Copy to .env.local and adjust. Restart the server after changing anything here.
# .env.local is git-ignored; never commit real values for anything sensitive.

# Where the SQLite database lives (default: data/app.db)
# DATABASE_PATH=./data/app.db

# How amounts are displayed (baked in at build time: rebuild for `npm run start`)
# NEXT_PUBLIC_CURRENCY=BRL
# NEXT_PUBLIC_LOCALE=en-US

# Extra hostnames the app may answer to, comma-separated. The default (empty) is localhost only.
# Only set this if you understand the risk: the app has no login.
# ALLOWED_HOSTS=
